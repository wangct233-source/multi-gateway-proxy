# Copy to .env and restrict its ACL/permissions. Never commit .env or real tokens.
# Set a long random ADMIN_TOKEN locally. An empty admin token is not a deployment.
ADMIN_TOKEN=
# Empty means fall back to ADMIN_TOKEN; otherwise comma-separated data-plane tokens.
DATA_TOKENS=
DATABASE_PATH=/app/data/proxy.db
CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:5173
ALLOW_NULL_ORIGIN=false

TASKS_KILL_SWITCH=true
STREAM_TOTAL_TIMEOUT=600
STREAM_IDLE_TIMEOUT=60
CONNECT_TIMEOUT=10
REQUEST_BODY_LIMIT=1048576
SOFT_MEMORY_MB=256
MEMORY_WATERMARK=0.8
MEM_RESERVATION=256m
MEM_LIMIT=512m
CPU_LIMIT=2.0

UPDATES_ENABLED=false
UPDATES_REPO_SLUG=
UPDATES_BRANCH=main
UPDATES_POLL_SECONDS=300
# Image-mode updates: the host update script sets MGP_IMAGE (ghcr.io/...:sha-<commit>)
# and recreates the container. Leave unset to always pull the latest prebuilt image.
MGP_IMAGE=
# false (default): check only marks a candidate "available"; apply via admin API/UI button.
# true: a successful check arms the update immediately (previous behavior).
UPDATES_AUTO_APPLY=false
UPDATES_WEBHOOK_SECRET=
UPDATES_GRACE_SECONDS=600
PUBLIC_BACKEND_URL=
# Example only. For actual Compose deployment set ../runtime/keys (outside repo).
# Compose maps this host directory read-only to /app/runtime/keys.
DEPLOY_KEY_DIR=./runtime/keys

# Modes: disabled|openai|a|b-remote|c-anthropic.
# Safe defaults disable every upstream. B/C native protocols are not implemented
# in the new Python integration: never infer support from the original projects.
# Local mock: explicitly use openai + direct://local for each tested gateway.
# Empty PRIMARY means 503, including when BACKUP is supplied; no silent direct.
# Real proxies: http://host:port, https://host:port, socks5://host:port.
# For a host proxy inside Docker use host.docker.internal, not 127.0.0.1.
# direct://local is development-only and does NOT prove independent public IPs.
# secret_ref contains an env variable NAME or env:NAME, never the token itself.
# metadata is non-secret only; env_ref credentials live exclusively in .env.

A_CN_UPSTREAM_URL=
A_CN_UPSTREAM_MODE=disabled
A_CN_EGRESS_PRIMARY=
A_CN_EGRESS_BACKUP=
A_CN_EGRESS_CHECK_URL=https://example.com
# 全局并发 = 启用账号数 × 每账号并发（自动伸缩）；WorkBuddy(A) 默认 5/账号。
A_CN_ACCOUNT_CONCURRENCY=5
A_CN_QUEUE_LIMIT=32
A_CN_QUEUE_TIMEOUT=15
# Only enable after authorized protocol review. No fake UA/device or captcha logic.
A_CN_CHECKIN_VERIFIED=false
A_CN_BILLING_URL=
A_CN_TASKS_ENABLED=false
A_CN_TASK_WINDOW_START=00:00
A_CN_TASK_WINDOW_END=23:59
A_CN_TASK_DAILY_LIMIT=1
A_CN_ACCOUNTS_JSON='[{"id":"a-cn-account-1","provider_account_id":"local-a-cn-1","secret_ref":"env:A_CN_ACCOUNT_1_TOKEN","enabled":false,"metadata":{}}]'
A_CN_ACCOUNT_1_TOKEN=

A_INTL_UPSTREAM_URL=
A_INTL_UPSTREAM_MODE=disabled
A_INTL_EGRESS_PRIMARY=
A_INTL_EGRESS_BACKUP=
A_INTL_EGRESS_CHECK_URL=https://example.com
# 全局并发 = 启用账号数 × 每账号并发（自动伸缩）；WorkBuddy(A) 默认 5/账号。
A_INTL_ACCOUNT_CONCURRENCY=5
A_INTL_QUEUE_LIMIT=32
A_INTL_QUEUE_TIMEOUT=15
A_INTL_TASKS_ENABLED=false
A_INTL_TASK_WINDOW_START=00:00
A_INTL_TASK_WINDOW_END=23:59
A_INTL_TASK_DAILY_LIMIT=1
A_INTL_ACCOUNTS_JSON='[{"id":"a-intl-account-1","provider_account_id":"local-a-intl-1","secret_ref":"env:A_INTL_ACCOUNT_1_TOKEN","enabled":false,"metadata":{}}]'
A_INTL_ACCOUNT_1_TOKEN=

B_UPSTREAM_URL=
B_UPSTREAM_MODE=disabled
B_EGRESS_PRIMARY=
B_EGRESS_BACKUP=
B_EGRESS_CHECK_URL=https://example.com
# 全局并发 = 启用账号数 × 每账号并发（自动伸缩）；默认 2/账号。
B_ACCOUNT_CONCURRENCY=2
B_QUEUE_LIMIT=32
B_QUEUE_TIMEOUT=15
# Requires real account metadata.device_id; no device rotation.
B_CHECKIN_VERIFIED=false
B_BILLING_URL=
B_TASKS_ENABLED=false
B_TASK_WINDOW_START=00:00
B_TASK_WINDOW_END=23:59
B_TASK_DAILY_LIMIT=1
B_ACCOUNTS_JSON='[{"id":"b-account-1","provider_account_id":"local-b-1","secret_ref":"env:B_ACCOUNT_1_TOKEN","enabled":false,"metadata":{}}]'
B_ACCOUNT_1_TOKEN=

C_UPSTREAM_URL=
C_UPSTREAM_MODE=disabled
C_EGRESS_PRIMARY=
C_EGRESS_BACKUP=
C_EGRESS_CHECK_URL=https://example.com
# 全局并发 = 启用账号数 × 每账号并发（自动伸缩）；默认 2/账号。
C_ACCOUNT_CONCURRENCY=2
C_QUEUE_LIMIT=32
C_QUEUE_TIMEOUT=15
C_TASKS_ENABLED=false
C_TASK_WINDOW_START=00:00
C_TASK_WINDOW_END=23:59
C_TASK_DAILY_LIMIT=1
C_ACCOUNTS_JSON='[{"id":"c-account-1","provider_account_id":"local-c-1","secret_ref":"env:C_ACCOUNT_1_TOKEN","enabled":false,"metadata":{}}]'
C_ACCOUNT_1_TOKEN=
